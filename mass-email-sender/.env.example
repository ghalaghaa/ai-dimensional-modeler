# SMTP credentials used to send outgoing mail.
# Gmail example: use smtp.gmail.com, port 587, and a Google "App Password"
# (not your normal password — requires 2FA enabled on the Google account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password

# Address shown in the "From" field. Defaults to SMTP_USER if unset.
FROM_EMAIL=you@gmail.com

# Port the local server listens on.
PORT=3000
