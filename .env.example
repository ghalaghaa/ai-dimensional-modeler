# Groq API key — used ONLY on the server (serverless function / dev proxy).
# Local dev: put it in a .env file (this file is gitignored).
# Production (Vercel): set GROQ_API_KEY in Project Settings > Environment Variables.
GROQ_API_KEY=your_api_key_here

# Optional: model name (safe to expose; not a secret).
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Groq speech-to-text model used by the voice call-center assistant.
VITE_GROQ_STT_MODEL=whisper-large-v3-turbo

# Base URL of the NAMAA-Saudi-TTS microservice (see /tts_service). It runs
# separately (needs a GPU + internet access to Hugging Face) and is NOT part
# of the Vercel deployment. Point this at wherever you run it.
VITE_TTS_SERVICE_URL=http://localhost:8000
