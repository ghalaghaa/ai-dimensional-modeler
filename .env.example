# Groq API key — used ONLY on the server (serverless function / dev proxy).
# Local dev: put it in a .env file (this file is gitignored).
# Production (Vercel): set GROQ_API_KEY in Project Settings > Environment Variables.
GROQ_API_KEY=your_api_key_here

# Optional: model name (safe to expose; not a secret).
VITE_GROQ_MODEL=llama-3.3-70b-versatile
