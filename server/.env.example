# --- Server ---
PORT=5001
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5001

# 32-byte hex key used to encrypt OAuth tokens at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth (Gmail API) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable the "Gmail API", create an OAuth Client (Web application), and add
# GOOGLE_REDIRECT_URI below to its "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/google/callback

# --- Microsoft OAuth (Microsoft Graph) ---
# Register an app at https://portal.azure.com (Azure AD App registrations).
# Add GOOGLE_REDIRECT_URI-equivalent below as a Web platform redirect URI,
# and grant delegated Microsoft Graph permission "Mail.Send" + "offline_access".
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5001/api/auth/microsoft/callback

# --- AI personalization (optional bonus feature) ---
# Uses Groq's OpenAI-compatible chat completions endpoint.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
